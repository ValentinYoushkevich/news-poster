DATABASE_URL="postgresql://newsposter:newsposter@localhost:5436/newsposter?schema=public"
PORT=3000
# Заполняются в Фазе 3, но объявлены заранее:
BOT_TOKEN=""
SERVICE_CHAT_ID=""
PREVIEW_TTL_DEFAULT=1440
OLLAMA_URL="http://localhost:11434"
EMBED_MODEL="bge-m3"
OPENROUTER_URL="https://openrouter.ai/api/v1/chat/completions"
OPENROUTER_API_KEY=""
REWRITE_MODEL="openai/gpt-4o-mini"
DEDUP_THRESHOLD=0.85
DEDUP_WINDOW_HOURS=24

# Креды страницы логина админки (сессии проверяет бэкенд, /auth). Если не заданы — админка открыта без логина
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# true — ставить secure-флаг на сессионную куку админки (включать, когда админка за HTTPS)
# ADMIN_COOKIE_SECURE=true
